+    id                 TEXT PRIMARY KEY,
+    org_id             TEXT NOT NULL REFERENCES orgs(id) ON DELETE CASCADE,
+    project_version_id TEXT NOT NULL REFERENCES project_versions(id) ON DELETE CASCADE,
